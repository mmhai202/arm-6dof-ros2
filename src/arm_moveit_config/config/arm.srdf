<?xml version="1.0" encoding="UTF-8"?>
<robot name="arm_sim">
  <virtual_joint name="world_joint" type="fixed" parent_frame="world" child_link="base_footprint"/>

  <group name="arm">
    <chain base_link="base_link" tip_link="tcp"/>
  </group>
  <group name="gripper">
    <link name="gripper_palm"/>
    <joint name="finger_left_joint"/>
    <joint name="finger_right_joint"/>
  </group>
  <end_effector name="parallel_gripper" parent_link="tcp" group="gripper" parent_group="arm"/>
  <group_state name="open" group="gripper">
    <joint name="finger_left_joint" value="0.025"/>
    <joint name="finger_right_joint" value="0.025"/>
  </group_state>
  <group_state name="closed" group="gripper">
    <joint name="finger_left_joint" value="0.0"/>
    <joint name="finger_right_joint" value="0.0"/>
  </group_state>

  <group_state name="home" group="arm">
    <joint name="joint_1" value="0.0"/>
    <joint name="joint_2" value="-1.57079632679"/>
    <joint name="joint_3" value="0.0"/>
    <joint name="joint_4" value="-1.57079632679"/>
    <joint name="joint_5" value="0.0"/>
    <joint name="joint_6" value="0.0"/>
  </group_state>

  <!-- Bent elbow and wrist leave room for interactive TCP translation/rotation. -->
  <group_state name="ready" group="arm">
    <joint name="joint_1" value="0.0"/>
    <joint name="joint_2" value="-1.0"/>
    <joint name="joint_3" value="1.2"/>
    <joint name="joint_4" value="-1.8"/>
    <joint name="joint_5" value="1.0"/>
    <joint name="joint_6" value="0.0"/>
  </group_state>

  <group_state name="zero" group="arm">
    <joint name="joint_1" value="0.0"/>
    <joint name="joint_2" value="0.0"/>
    <joint name="joint_3" value="0.0"/>
    <joint name="joint_4" value="0.0"/>
    <joint name="joint_5" value="0.0"/>
    <joint name="joint_6" value="0.0"/>
  </group_state>

  <disable_collisions link1="base_link" link2="link_1" reason="Adjacent"/>
  <disable_collisions link1="base_link" link2="link_2" reason="Never"/>
  <disable_collisions link1="link_1" link2="link_2" reason="Adjacent"/>
  <disable_collisions link1="link_2" link2="link_3" reason="Adjacent"/>
  <disable_collisions link1="link_3" link2="link_4" reason="Adjacent"/>
  <disable_collisions link1="link_4" link2="link_5" reason="Adjacent"/>
  <disable_collisions link1="link_5" link2="link_6" reason="Adjacent"/>
  <!-- flange is fixed to link_6; its simplified collision shape also touches
       link_5 at the joint_6 interface, as part of the same wrist assembly. -->
  <disable_collisions link1="link_5" link2="flange" reason="Adjacent"/>
  <disable_collisions link1="link_6" link2="flange" reason="Adjacent"/>
  <disable_collisions link1="flange" link2="tool0" reason="Adjacent"/>
  <disable_collisions link1="tool0" link2="tcp" reason="Adjacent"/>
  <disable_collisions link1="tool0" link2="gripper_palm" reason="Adjacent"/>
  <disable_collisions link1="gripper_palm" link2="finger_left" reason="Adjacent"/>
  <disable_collisions link1="gripper_palm" link2="finger_right" reason="Adjacent"/>
</robot>
